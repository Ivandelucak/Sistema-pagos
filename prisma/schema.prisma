generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id       Int     @id @default(autoincrement())
  nombre   String
  email    String  @unique
  password String
  rol      Role
  activo   Boolean @default(true)

  clients        Client[]
  credits        Credit[]        @relation("CreditSeller")
  createdCredits Credit[]        @relation("CreditCreator")
  payments       Payment[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())

  @@map("user")
}

model Client {
  id              Int                   @id @default(autoincrement())
  nombre          String
  telefono        String?
  direccion       String?
  observacion     String?               @db.Text
  observacionTipo ClientObservationType @default(NORMAL)
  activo          Boolean               @default(true)

  vendedorId Int
  vendedor   User @relation(fields: [vendedorId], references: [id])

  credits Credit[]

  createdAt DateTime @default(now())

  @@map("client")
}

model Credit {
  id          Int  @id @default(autoincrement())
  clientId    Int
  vendedorId  Int
  createdById Int?

  fechaInicio    DateTime
  tipo           String
  frecuenciaDias Int
  cantidadCuotas Int      @default(1)
  valorCuota     Float

  total       Float
  montoPagado Float @default(0)
  saldo       Float

  estado String
  activo Boolean @default(true)

  proximoVencimiento DateTime?
  cuotasPagadas      Int       @default(0)
  cuotasRestantes    Int       @default(0)

  client    Client @relation(fields: [clientId], references: [id])
  vendedor  User   @relation("CreditSeller", fields: [vendedorId], references: [id])
  createdBy User?  @relation("CreditCreator", fields: [createdById], references: [id], onDelete: SetNull)

  payments       Payment[]
  products       CreditProduct[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())

  @@map("credit")
}

model Payment {
  id         Int           @id @default(autoincrement())
  creditId   Int
  monto      Float
  fechaPago  DateTime
  metodoPago PaymentMethod @default(EFECTIVO)

  registradoPor Int
  user          User @relation(fields: [registradoPor], references: [id])

  credit Credit @relation(fields: [creditId], references: [id])

  createdAt DateTime @default(now())

  @@map("payment")
}

model ProductCategory {
  id           Int     @id @default(autoincrement())
  codePrefix   String  @unique
  name         String
  slug         String  @unique
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  products StockProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_category")
}

model StockProduct {
  id         Int     @id @default(autoincrement())
  code       String  @unique
  name       String
  slug       String?
  categoryId Int

  brand         String?
  sourceWebCode String?

  cost          Float
  cashPrice     Float
  financedPrice Float

  stock         Int @default(0)
  lowStockAlert Int @default(2)

  imageUrl String? @db.Text
  active   Boolean @default(true)

  category       ProductCategory @relation(fields: [categoryId], references: [id])
  creditProducts CreditProduct[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stock_product")
}

model CreditProduct {
  id        Int @id @default(autoincrement())
  creditId  Int
  productId Int

  quantity Int @default(1)

  productCodeSnapshot   String
  productNameSnapshot   String
  cashPriceSnapshot     Float
  financedPriceSnapshot Float
  costSnapshot          Float?

  credit  Credit       @relation(fields: [creditId], references: [id])
  product StockProduct @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@map("credit_product")
}

model StockMovement {
  id        Int @id @default(autoincrement())
  productId Int

  type StockMovementType

  quantity      Int
  previousStock Int
  newStock      Int

  creditId Int?
  userId   Int?

  note String? @db.Text

  product StockProduct @relation(fields: [productId], references: [id])
  credit  Credit?      @relation(fields: [creditId], references: [id])
  user    User?        @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("stock_movement")
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
}

enum Role {
  ADMIN
  VENDEDOR
}

enum ClientObservationType {
  NORMAL
  ALERTA
}

enum StockMovementType {
  INITIAL
  ADJUSTMENT
  SALE
  RETURN
  EDIT
}
